# 複製成 .env.local（不進 repo），npm run dev 會讀它
DATA_DIR=./data
PORT=8080
# 只開部分服務：PROVIDERS=claude,openrouter
PROVIDERS=

# 選填（都有預設值）：輪詢間隔、沒人看後多久停、請求逾時、SSE 單一連線最長時間／ping 間隔／連線數上限
# POLL_INTERVAL_SEC=120
# IDLE_GRACE_SEC=90
# REQUEST_TIMEOUT_MS=10000
# SSE_MAX_AGE_SEC=1800
# SSE_PING_SEC=25
# SSE_MAX_CLIENTS=20

# 32 bytes 隨機 base64：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=
ADMIN_TOKEN=
# 選填：強制用環境變數重設某幾家的憑證（蓋過 volume 裡續期過的），例如 claude,codex；部署後記得拿掉
CREDENTIALS_RESET=
# 選填：設了之後資料 API 要網址帶 ?k=<ACCESS_KEY> 才看得到（之後記在 cookie）
ACCESS_KEY=

# 選填：Web Push 通知（npm run gen-vapid 產生；VAPID 兩把金鑰＋PUSH_KEY 都設才啟用）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 訂閱時要輸入的密碼
PUSH_KEY=
# 排程喚醒（POST /api/push/tick）用的 token，GitHub Actions 的 secret 也要設同一個
PUSH_TICK_TOKEN=
# VAPID_SUBJECT=https://ai-usageweb.fly.dev
# PUSH_TZ=Asia/Taipei
# 勿擾時段（當地時間，off 代表不設）
# PUSH_QUIET=00-08

OPENROUTER_API_KEY=

# Claude：獨立登入的 refresh token，或 claude setup-token 的長效 token（CLAUDE_OAUTH_TOKEN）
CLAUDE_ACCESS_TOKEN=
CLAUDE_REFRESH_TOKEN=
CLAUDE_EXPIRES_AT=
CLAUDE_OAUTH_TOKEN=
CLAUDE_PLAN=Pro
# 訂閱到期日（API 拿不到，手動填；卡片會顯示剩幾天）
CLAUDE_PLAN_EXPIRES_AT=

CODEX_ACCESS_TOKEN=
CODEX_REFRESH_TOKEN=
CODEX_ACCOUNT_ID=

ANTIGRAVITY_REFRESH_TOKEN=
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=
ANTIGRAVITY_PROJECT_ID=

# 端點與 client id 都可以覆寫（內部端點常變）：
# CLAUDE_USAGE_URL= CLAUDE_TOKEN_URL= CLAUDE_CLIENT_ID=
# CODEX_USAGE_URL= CODEX_TOKEN_URL= CODEX_CLIENT_ID=
# ANTIGRAVITY_BASE_URL= ANTIGRAVITY_TOKEN_URL= ANTIGRAVITY_USER_AGENT=
# OPENROUTER_BASE_URL=
# OpenRouter 排行榜（非官方端點）與模型列表：
# OPENROUTER_RANKINGS_URL= OPENROUTER_MODELS_URL=
