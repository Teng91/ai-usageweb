# 複製成 .env.local（不進 repo），npm run dev 會讀它
DATA_DIR=./data
PORT=8080
# 只開部分服務：PROVIDERS=openrouter,copilot
PROVIDERS=

# 32 bytes 隨機 base64：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=
ADMIN_TOKEN=
# 選填：強制用環境變數重設某幾家的憑證（蓋過 volume 裡續期過的），例如 claude,codex；部署後記得拿掉
CREDENTIALS_RESET=
# 選填：設了之後資料 API 要網址帶 ?k=<ACCESS_KEY> 才看得到（之後記在 cookie）
ACCESS_KEY=

OPENROUTER_API_KEY=
GITHUB_COPILOT_TOKEN=

# Claude：獨立登入的 refresh token，或 claude setup-token 的長效 token（CLAUDE_OAUTH_TOKEN）
CLAUDE_ACCESS_TOKEN=
CLAUDE_REFRESH_TOKEN=
CLAUDE_EXPIRES_AT=
CLAUDE_OAUTH_TOKEN=
CLAUDE_PLAN=Pro
# 訂閱到期日（API 拿不到，手動填；卡片會顯示剩幾天）
CLAUDE_PLAN_EXPIRES_AT=

CODEX_ACCESS_TOKEN=
CODEX_REFRESH_TOKEN=
CODEX_ACCOUNT_ID=

ANTIGRAVITY_REFRESH_TOKEN=
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=
ANTIGRAVITY_PROJECT_ID=

# 端點與 client id 都可以覆寫（內部端點常變）：
# CLAUDE_USAGE_URL= CLAUDE_TOKEN_URL= CLAUDE_CLIENT_ID=
# CODEX_USAGE_URL= CODEX_TOKEN_URL= CODEX_CLIENT_ID=
# ANTIGRAVITY_BASE_URL= ANTIGRAVITY_TOKEN_URL= ANTIGRAVITY_USER_AGENT=
# COPILOT_USER_URL= OPENROUTER_BASE_URL=
# OpenRouter 排行榜（非官方端點）與模型列表：
# OPENROUTER_RANKINGS_URL= OPENROUTER_MODELS_URL=
